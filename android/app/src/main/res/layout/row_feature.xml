<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
    <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/bg_card" android:importantForAccessibility="no" android:padding="10dp"
        android:tint="@color/brand_blue" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/Text.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/desc" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
