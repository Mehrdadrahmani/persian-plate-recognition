<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical">

    <FrameLayout android:id="@+id/container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:id="@+id/credit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="2dp"
        android:text="@string/credit" android:textColor="@color/on_surface_muted" android:textDirection="ltr"
        android:textSize="10sp" android:alpha="0.8" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemTextAppearanceActive="@style/Text.Caption" app:itemTextAppearanceInactive="@style/Text.Caption"
        app:labelVisibilityMode="labeled" app:menu="@menu/bottom_nav" />
</LinearLayout>
